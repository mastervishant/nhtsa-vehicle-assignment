{
  "name": "nhtsa-vehicle-assignment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "ingest": "ts-node src/scripts/ingest.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
    "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
