    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@apollo/server": "4.11.3",
    "@nestjs/apollo": "12.2.2",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/graphql": "12.2.2",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/typeorm": "10.0.2",
    "axios": "1.7.9",
    "cache-manager": "^5.7.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "fast-xml-parser": "5.0.8",
    "graphql": "16.10.0",
    "ioredis": "5.8.2",
    "joi": "^18.2.9",
    "nestjs-pino": "^4.4.0",
    "pg": "8.13.1",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.70.1"
  }
